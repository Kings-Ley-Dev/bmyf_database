{
  "name": "bmyf-database",
  "version": "1.0.0",  
  "private": true,
  "description": "Beulah Methodist Youth Fellowship member and attendance database API",
  "main": "api/index.js",
  "scripts": {
    "dev": "concurrently -n api,app -c cyan,yellow \"npm:api\" \"npm:client\"",
    "api": "node --watch api/index.js",
    "client": "npm --prefix client run dev",
    "start": "node api/index.js",
    "setup": "npm install && npm --prefix client install",
    "test": "node test/smoke.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
